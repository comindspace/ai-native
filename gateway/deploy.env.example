# Copy this file to /opt/gateway-mcp/.env on the runner host.
# Keep real values only on the server or in a secret manager. Do not commit .env.

POSTGRES_PASSWORD=change-me
GATEWAY_JWT_SECRET=change-me-32-plus-bytes
GATEWAY_TOKEN_TTL_SECONDS=31536000
GATEWAY_REFRESH_TOKEN_TTL_SECONDS=31536000
GATEWAY_USER_TOKEN_ENCRYPTION_KEY=
GATEWAY_SERVER_VERSION=0.1.0
GATEWAY_STATELESS_LEGACY_HTTP=true
GATEWAY_MAX_REQUEST_BODY_BYTES=4194304
GATEWAY_MCP_CATALOG_TTL_MS=300000
# Keep false while MCP clients depend on Dynamic Client Registration. Enable only
# when every advertised CIMD client metadata URL is reachable from the Gateway.
GATEWAY_CIMD_ENABLED=false
GATEWAY_CIMD_ALLOWED_HOSTS=
# Cursor may register cursor://anysphere.cursor-mcp/oauth/callback together
# with HTTPS and loopback callbacks. Keep this allowlist explicit.
GATEWAY_OAUTH_ALLOWED_CUSTOM_SCHEMES=cursor
GATEWAY_IDEMPOTENCY_TTL_SECONDS=86400
GATEWAY_MANAGED_CONNECTION_CACHE_SECONDS=5
# Opt-in Git proxy for claimed Factory work; requires explicit factory:git scope.
GATEWAY_FACTORY_GIT_ENABLED=false
GATEWAY_FILE_TRANSFER_DIR=/data/gateway/files
GATEWAY_FILE_TRANSFER_MAX_BYTES=104857600
GATEWAY_FILE_UPLOAD_TTL_SECONDS=3600
GATEWAY_FILE_DOWNLOAD_TTL_SECONDS=300
GATEWAY_PRIVACY_POLICY=standard
# Use a dedicated random secret in production. If empty, GATEWAY_JWT_SECRET is used.
GATEWAY_PRIVACY_HMAC_SECRET=
# Optional JSON map: {"person":["Name"],"client":["Company"]}.
GATEWAY_PRIVACY_TERMS_FILE=
GATEWAY_LLM_PROXY_MAX_BODY_BYTES=4194304
GATEWAY_LLM_PROXY_TIMEOUT_SECONDS=180
GATEWAY_LLM_ALLOW_INSECURE_UPSTREAM=false
# These four values can instead be managed at /admin/integrations.
GATEWAY_LLM_UPSTREAM_URL=
GATEWAY_LLM_UPSTREAM_API_KEY=
GATEWAY_LLM_DEFAULT_MODEL=
GATEWAY_LLM_ALLOWED_MODELS=

GATEWAY_PUBLIC_URL=https://mcp.example.com
GATEWAY_ISSUER_URL=https://mcp.example.com
GATEWAY_RESOURCE_URL=https://mcp.example.com/mcp
GATEWAY_ALLOWED_EMAIL_DOMAINS=example.com
GATEWAY_RESOURCE_POLICY_MODE=permissive
GATEWAY_ALLOW_SERVER_YANDEX_TOKENS=false
GATEWAY_ALLOW_SERVER_GITLAB_TOKEN=false
GATEWAY_KNOWLEDGE_VAULT_HOST=/opt/gateway-mcp/company-knowledge-vault
GATEWAY_KNOWLEDGE_VAULT_PATH=/data/company-knowledge-vault
GATEWAY_KNOWLEDGE_INGEST_DIRS=
GATEWAY_KNOWLEDGE_INGEST_MAX_BYTES=1048576

YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# Main Yandex OAuth app for login, Tracker, and Mail.
# Tracker routes need tracker:read/tracker:write grants in the Yandex OAuth app.
# Mail routes need Yandex Mail IMAP/SMTP OAuth scopes and IMAP enabled on the mailbox.
YANDEX_OAUTH_SCOPES=login:email login:info tracker:read tracker:write mail:imap_full mail:smtp
# Separate OAuth app for Yandex Disk to avoid Yandex permission-count limits.
YANDEX_DISK_OAUTH_CLIENT_ID=
YANDEX_DISK_OAUTH_CLIENT_SECRET=
YANDEX_DISK_OAUTH_SCOPES=cloud_api:disk.read cloud_api:disk.write cloud_api:disk.info
YANDEX_OAUTH_ACCESS_TOKEN=
# Shared Yandex OAuth token for Metrika routes (read-only web analytics).
# Belongs to a Yandex account with representative access to the company counters.
# Access is granted through the analytics-readers Gateway group, not Yandex.
YANDEX_METRIKA_OAUTH_ACCESS_TOKEN=
# Shared Yandex OAuth token for Webmaster routes. May be the same token as
# Metrika; YANDEX_METRIKA_OAUTH_ACCESS_TOKEN is used as fallback when empty.
YANDEX_WEBMASTER_OAUTH_ACCESS_TOKEN=

# Google OAuth app for per-user Google Drive, Google Docs, and Google Sheets credentials.
# Redirect URI: ${GATEWAY_PUBLIC_URL}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/spreadsheets https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/documents
YANDEX_MAIL_IMAP_HOST=imap.yandex.com
YANDEX_MAIL_IMAP_PORT=993
YANDEX_MAIL_SMTP_HOST=smtp.yandex.com
YANDEX_MAIL_SMTP_PORT=465

YONOTE_API_KEY=
YONOTE_BASE_URL=https://wiki.example.com
GATEWAY_COMPANY_YONOTE_INDEX_ID=
GATEWAY_COMPANY_PEOPLE_INDEX_ID=
GATEWAY_COMPANY_PROJECTS_INDEX_ID=
GATEWAY_COMPANY_PROCESSES_INDEX_ID=
GATEWAY_COMPANY_DOCUMENTS_INDEX_ID=
GATEWAY_COMPANY_DECISIONS_INDEX_ID=
GATEWAY_COMPANY_OPERATIONS_INDEX_ID=

TRACKER_IAM_TOKEN=
TRACKER_ORG_ID=
TRACKER_CLOUD_ORG_ID=
TRACKER_API_BASE_URL=https://api.tracker.yandex.net

GITLAB_TOKEN=
GITLAB_API_BASE_URL=https://gitlab.example.com/api/v4

# Infra routes keep server metadata and SSH credential handles in Postgres.
# Private keys stay on the GatewayMCP host or a vault; never put them in env.
GATEWAY_INFRA_SSH_SECRETS_HOST=/opt/agent-dev-factory/secrets/ssh

YANDEX_DISK_API_BASE_URL=https://cloud-api.yandex.net/v1/disk
GOOGLE_DRIVE_API_BASE_URL=https://www.googleapis.com/drive/v3
GOOGLE_DOCS_API_BASE_URL=https://docs.googleapis.com/v1
GOOGLE_SHEETS_API_BASE_URL=https://sheets.googleapis.com/v4/spreadsheets

BITRIX24_WEBHOOK_URL=

OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIBE_MODEL=
OPENROUTER_ALLOWED_AUDIO_DIRS=
OPENROUTER_MAX_AUDIO_SIZE_MB=10

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# Бот-токен для Bot API (notifications.skill_update.send); работает через HTTPS_PROXY,
# в отличие от MTProto-сессии выше
TELEGRAM_BOT_TOKEN=
# Основное имя переменной чата для post-merge уведомлений об обновлении скиллов.
# Устаревшее GATEWAY_COMIND_MR_REVIEW_CHAT_ID бэкенд по-прежнему читает.
GATEWAY_SKILL_UPDATE_CHAT_ID=
GATEWAY_COMIND_CHAT_ID=
GATEWAY_COMIND_MR_REVIEW_CHAT_ID=

CALDAV_URL=https://caldav.yandex.ru
